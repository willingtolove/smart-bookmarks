{
  "name": "smart-bookmarks",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "A smart bookmark extension with AI auto-classification, semantic search, dead-link detection and smart recommendations.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:ui": "vite",
    "dev:watch": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "idb": "^8.0.0",
    "fuse.js": "^7.0.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
